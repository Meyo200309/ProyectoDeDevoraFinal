Segmento 4: Clase de Análisis
class DataAnalyzer:
    "Clase encargada de la analítica avanzada y modelos no supervisados."

    def apply_pca(self, df):
        "Aplica PCA sobre variables de comportamiento."
        np.random.seed(42)
        features_comportamiento = np.random.rand(len(df), 20)
        pca = PCA(n_components=3)
        componentes = pca.fit_transform(features_comportamiento)
        df['PCA_1'], df['PCA_2'], df['PCA_3'] = componentes[:, 0], componentes[:, 1], componentes[:, 2]
        print(f"Varianza explicada: {sum(pca.explained_variance_ratio_):.2%}")
        return df

Segmento 5:Clase de Visualización (DataVisualizer)
class DataVisualizer:
    "Generación del Dashboard estático y gráficos avanzados."

    def generate_dashboard(self, df):
        "Crea Boxplots y Scatter Plots."
        plt.figure(figsize=(18, 5))
        plt.subplot(1, 2, 1)
        sns.boxplot(x='segmento_cliente', y='monto', data=df, palette='Set2')
        plt.title('Outliers en Ventas por Segmento')
        plt.subplot(1, 2, 2)
        sns.scatterplot(x='PCA_1', y='PCA_2', hue='segmento_cliente', data=df, palette='viridis')
        plt.title('Clusters tras PCA')
        plt.tight_layout()
        plt.savefig('dashboard_estatico.png')
        print("Dashboard exportado como dashboard_estatico.png")

    def plot_sankey(self):
        "Genera diagrama de Sankey."
        fig = go.Figure(data=[go.Sankey(
            node=dict(pad=15, thickness=20, line=dict(color="black", width=0.5),
                      label=["Visita Web", "Carrito", "Checkout", "Compra Final", "Abandono"]),
            link=dict(source=[0, 1, 2, 0, 1], target=[1, 2, 3, 4, 4], value=[2000, 1500, 1000, 1000, 500])
        )])
        fig.update_layout(title_text="Flujo de Usuarios a Compra", font_size=10)
        fig.write_html("sankey_diagram.html")
        print("Diagrama de Sankey exportado como sankey_diagram.html")

Segemento 6: Ejecución del Pipeline
if __name__ == "__main__":
    print("Iniciando Pipeline ETL...")
    extractor = DataExtractor("sqlite:///:memory:", "mongodb://localhost:27017/")
    
    # FASE 1: Extracción
    df_sql = extractor.extract_sql_incremental()
    df_mongo = extractor.extract_nosql()
    df_inv = extractor.extract_csv()
    
    # FASE 2: Transformación
    transformer = DataTransformer()
    df_inv_clean, df_sql_clean, df_mongo_clean = transformer.clean_data(df_inv, df_sql, df_mongo)
    df_master = transformer.normalize_and_enrich(df_sql_clean, df_mongo_clean)
    
    # FASE 3: Análisis
    analyzer = DataAnalyzer()
    df_master_pca = analyzer.apply_pca(df_master)
    
    # FASE 4: Visualización
    visualizer = DataVisualizer()
    visualizer.generate_dashboard(df_master_pca)
    visualizer.plot_sankey()
    
    # SALIDA
    df_master_pca.to_parquet('data_master_clean.parquet', index=False)
    print("Pipeline completado. Archivo data_master_clean.parquet generado exitosamente.")



